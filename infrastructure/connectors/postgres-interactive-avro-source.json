{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "plugin.name": "pgoutput",
  "tasks.max": "1",
  "slot.name": "dbz_interactive_avro_slot",
  "publication.name": "dbz_interactive_avro_pub",
  "publication.autocreate.mode": "all_tables",
  "decimal.handling.mode": "precise",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "postgres",
  "database.password": "postgres",
  "database.dbname": "cdcdemo",
  "topic.prefix": "slim",
  "schema.include.list": "interactive_examples_avro",
  "table.include.list": "interactive_examples_avro\\..*",
  "snapshot.mode": "initial",
  "key.converter": "io.confluent.connect.avro.AvroConverter",
  "key.converter.schemas.enable": "true",
  "key.converter.schema.registry.url": "http://schema-registry:8081",
  "value.converter": "io.confluent.connect.avro.AvroConverter",
  "value.converter.schemas.enable": "true",
  "value.converter.schema.registry.url": "http://schema-registry:8081",
  "transforms": "unwrap",
  "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
  "transforms.unwrap.add.fields": "op,source.table,source.ts_ms",
  "transforms.unwrap.delete.tombstone.handling.mode": "rewrite"
}
